# AWS CLI profile name (configured in ~/.aws/config)
AWS_PROFILE=your-profile

# AWS region
AWS_REGION=ap-northeast-1

# CloudWatch Logs: Default log group filter, comma-separated (e.g. "prod,api")
LOG_GROUP_FILTER=

# CloudWatch Logs: Exclude log groups, comma-separated (e.g. "test,debug")
LOG_GROUP_EXCLUDE=
